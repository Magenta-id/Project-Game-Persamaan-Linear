// Pola untuk PLSV
function buatSoalPLSV (pola, minAngka, maxAngka) {
 // Helper untuk ambil angka acak yang bukan 0
 const acak (min, max) => {
   let n = Math.floor (Math.random() *(max-min+1)) + min;
   return n === 0 ? 1 : n;
 };

  let x = acak(minAngka, maxAngka);
  //Kunci jawaban
  let a, b, c, d, teks;

  switch(pola) {
    // Pola 1: x + b = c atau x - b = c
    case 1: 
      b = acak(minAngka, maxAngka);
      c = x + b;
      teks = b >= 0 
        ? `x + ${b} = ${c}` 
        : `x - ${Math.abs(b)} = ${c}`;
      break;

    // Pola 2: ax = c
    case 2:
      a = acak(2, 5);
      c = a*x;
      teks = `${a}x = ${c}`;
      break;

    // Pola 3: ax + b = c
    case 3:
      a = acak(2, 8);
      b = acak(minAngka, maxAngka);
      c = (a*x) + b;
      teks = b >= 0 
        ? `${a}x + ${b} = ${c}`
        : `${a}x - ${Math.abs(b)} = ${c}`;
      break;

    // Pola 4: ax + b = cx + d (Variabel di kedua sisi)
    case 4:
      a = acak(3, 6);
      c = acak(1, a - 1); // Dipastikan c < a agar koefisien positif
      b = acak(minAngka, maxAngka);
      d = (a - c) * x + b;

      let teksB = b >= 0 ? '+ ${b}' : '- ${Math.abs(b)}';
      let teksD = d >= 0 ? '+ ${d}' : '- ${Math.abs(d)}';
      teks = `${a}x + ${teksB} = ${c}x + ${teksD}`;
      break;

    // Pola 5: a(x + b) = c (Bentuk kurung / distributif)
    case 5:
      a = acak(2, 6);
      b = acak(minAngka, maxAngka);
      c = a * (x + b);
      teks = b >= 0 
        ? `${a}(x + ${b}) = ${c}`
        : `${a}(x - ${Math.abs(b)}) = ${c}`;
      break;

    default:
      teks = `x = ${x}`;
  }
  // Mengembalikan hasil racikan
  return {teksSoal : teks, jawaban_x:x};
}

function buatSoalSPLDV (pola, minAngka, maxAngka, minKoef, maxKoef) {
 // Helper untuk ambil angka acak yang bukan 0
 const acak (min, max) => {
   let n = Math.floor (Math.random() *(max-min+1)) + min;
   return n === 0 ? 1 : n;
 };

  let x = acak(minAngka, maxAngka);
  let y = acak(minAngka, maxAngka);
  //Kunci jawaban
  let a, b, c, d, e, f, teks;

  switch(pola) {
    // Pola 1: x + y = w1 dan x - y = w2 (a+b=c dan d-e=f)
    case 1:
      c = x + y;
      f = x - y;
      teks = `x + y = ${c}<br>x - y = ${f}`;
      break;
      
    // Pola 2: ax + y = c dan x + y = f
    case 2:
      a = acak(2, maxKoef);
      c = (a*x) + y;
      f = x + y;
      teks = `${a}x + y = $(c)<br>x + y = ${f}`;
      break;

    // Pola 3: ax + by = c dan x + ey = f
    case 3:
      a = acak(2, maxKoef);
      b = acak(2, maxKoef);
      c = (a*x) + (b*y);
      e = acak(2, maxKoef);
      f = x + (e*y);
      teks = b >= 0 && e >=0 
        ? `${a}x + ${b}y = ${c}<br>x + ${e}y = ${f}`
        : `${a}x - ${Math.abs(b)}y = ${c}<br>x - ${Math.abs(e)}y = ${f}`;
      break;

    // Pola 4: ax + by = c dan dx + ey = f
    case 4:
      a = acak(2, maxKoef);
      b = acak(-minKoef, maxKoef);
      c = (a*x) + (b*y);
      d = acak(2, maxKoef);
      e = acak(2, maxKoef);
      f = (d*x) + (e*y);
      teks = b >= 0 && e >=0 
        ? `${a}x + ${b}y = ${c}<br>x + ${e}y = ${f}`
        : `${a}x - ${Math.abs(b)}y = ${c}<br>x - ${Math.abs(e)}y = ${f}`;
      break;

    default:
      teks = `x = ${x}`;
  }
  // Mengembalikan hasil racikan
  return {teksSoal : teks, jawaban_x:x, jawaban_y:y};
}


function buatSoalSPLTV (pola, minAngka, maxAngka, minKoef, maxKoef) {
 const acak (min, max) => {
   let n = Math.floor (Math.random()*(max-min+1)) + min;
   return n === 0 ? 1 : n;
 };

  let x = acak(minAngka, maxAngka);
  let y = acak(minAngka, maxAngka);
  let z = acak(minAngka, maxAngka);

  let a, b, c, d, e, f, g, h, i, j, k, l, teks;

  switch (pola){
    // Pola 1: a + b + c = d etc... 
    case 1:
      d = x + y + z;
      h = x - y + z;
      l = x + y - z;
      teks = `x + y + z = ${d}<br>x - y + z = ${h}<br>x + y - z = ${l}`;
      break;

    // Pola 2
    case 2:
      a = acak(2, maxKoef);
      d = (a*x) + y + z;
      f = acak(2, maxKoef);
      h = x + (f*y) + z;
      k = acak(2, maxKoef);
      l = x + y + (k*z);

      let df = f >= 0 ? `+ ${f}` : `- ${Math.abs(f)}`;
      let dk = k >= 0 ? `+ ${k}` : `- ${Math.abs(k)}`;

      teks = `${a}x + y + z = ${d}<br>x ${df}y + z = ${h}<br>x + y ${dk}z = ${l}`
      break;

    //Pola 3
    case 3:
      a = acak(minKoef, maxKoef);
      b = acak(minKoef, maxKoef);
      c = acak(minKoef, maxKoef);
      d = (a*x) + (b*y) + (c*z);
      e = acak(minKoef, maxKoef);
      f = acak(minKoef, maxKoef);
      g = acak(minKoef, maxKoef);
      h = (e*x) + (f*y) + (g*z);
      i = acak(minKoef, maxKoef);
      j = acak(minKoef, maxKoef);
      k = acak(minKoef, maxKoef);
      l = (i*x) + (j*y) + (k*z);

      let tb = b >= 0 ? `+ ${b}` : `- ${Math.abs(b)}`;
      let tc = c >= 0 ? `+ ${c}` : `- ${Math.abs(c)}`;
      let tf = f >= 0 ? `+ ${f}` : `- ${Math.abs(f)}`;
      let tg = g >= 0 ? `+ ${g}` : `- ${Math.abs(g)}`;
      let tj = j >= 0 ? `+ ${j}` : `- ${Math.abs(j)}`;
      let tk = k >= 0 ? `+ ${k}` : `- ${Math.abs(k)}`;

      teks = `${a}x ${tb}y ${tc}z = ${d}<br>${e}x ${tf}y ${tg}z = ${h}<br>${i}x ${tj}y ${tk}z = ${l}`
      break;
  }
}

