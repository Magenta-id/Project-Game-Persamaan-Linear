<button type="button" onclick="waktu('tanpa_waktu')">Tanpa Waktu</button>
<button type="button" onclick="waktu(180)">3 Menit</button>
  <button type="button" onclick="waktu(300)">5 Menit</button>
  <button type="button" onclick="waktu(600)">10 Menit</button>
</details>
  
