<!-- Tombol pemilih mode (Trial/Challenge) -->
<button type="button" id="switch-mode" onclick="ganti-mode()">Latihan</button>

<!-- Tombol Switch-mode 1v / 2v / 3v --->
<button type="button" id="switch-var" onclick="ganti-var()">Satu Variabel</button>

<!-- Timer -->
<div id="timer">00:00</div>

<!-- Pemilih Level -->
<details>
  <summary>Pilih Level Game</summary>
  
<!-- Pilihan yang muncul saat diklik -->
